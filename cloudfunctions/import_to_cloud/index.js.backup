// 数据导入云函数
// 用于将导出的 JSON 数据导入到云数据库
// 支持每日一言数据库初始化和数据迁移

const fs = require('fs');
const path = require('path');

// 云函数模块仅在云函数环境中加载
let cloud;
let db;
let dailyCharactersCollection;
let dailyQuotesCollection;
let dailyQuotesConfigCollection;

/**
 * 初始化云开发环境
 */
function initCloud() {
  if (!cloud) {
    cloud = require('wx-server-sdk');
    cloud.init({
      env: cloud.DYNAMIC_CURRENT_ENV
    });
    db = cloud.database();
    dailyCharactersCollection = db.collection('daily_characters');
    dailyQuotesCollection = db.collection('daily_quotes');
    dailyQuotesConfigCollection = db.collection('daily_quotes_config');
  }
  return { cloud, db, dailyCharactersCollection, dailyQuotesCollection, dailyQuotesConfigCollection };
}

/**
 * 导入数据到云数据库
 * @param {Array} data - 要导入的数据数组
 * @param {number} batchSize - 批次大小
 * @returns {Object} 导入结果
 */
async function importData(data, batchSize = 50) {
  if (!Array.isArray(data) || data.length === 0) {
    return {
      success: false,
      message: '数据为空或格式错误',
      imported: 0,
      failed: 0,
      errors: []
    };
  }

  // 初始化云开发环境
  const { db } = initCloud();

  let imported = 0;
  let failed = 0;
  const errors = [];
  const total = data.length;

  console.log(`开始导入数据，共 ${total} 条`);
  console.log(`批次大小: ${batchSize}`);

  // 分批导入
  for (let i = 0; i < data.length; i += batchSize) {
    const batch = data.slice(i, i + batchSize);
    const batchStart = i + 1;
    const batchEnd = Math.min(i + batchSize, total);

    console.log(`处理批次: ${batchStart}-${batchEnd}`);

    try {
      // 使用事务批量导入
      const transaction = await db.startTransaction();
      
      for (const item of batch) {
        try {
          // 检查是否已存在相同 ID 的记录
          const existing = await transaction.collection('daily_characters')
            .where({ id: item.id })
            .get();

          if (existing.data.length > 0) {
            // 更新现有记录
            await transaction.collection('daily_characters')
              .where({ id: item.id })
              .update({
                data: item
              });
          } else {
            // 插入新记录
            await transaction.collection('daily_characters')
              .add({
                data: item
              });
          }

          imported++;
        } catch (error) {
          console.error(`导入第 ${item.id} 条数据失败:`, error);
          failed++;
          errors.push({
            id: item.id,
            char: item.char,
            error: error.message
          });
        }
      }

      // 提交事务
      await transaction.commit();
      console.log(`批次 ${batchStart}-${batchEnd} 处理完成`);

    } catch (error) {
      console.error(`批次 ${batchStart}-${batchEnd} 处理失败:`, error);
      failed += batch.length;
      errors.push({
        batch: `${batchStart}-${batchEnd}`,
        error: error.message
      });
    }

    // 每批处理后暂停一下，避免触发频率限制
    if (i + batchSize < data.length) {
      await new Promise(resolve => setTimeout(resolve, 1000));
    }
  }

  console.log(`数据导入完成`);
  console.log(`成功: ${imported}`);
  console.log(`失败: ${failed}`);

  return {
    success: failed === 0,
    message: `导入完成，成功 ${imported} 条，失败 ${failed} 条`,
    imported,
    failed,
    total,
    errors
  };
}

/**
 * 读取 JSON 数据文件
 * @param {string} filePath - 文件路径
 * @returns {Array} 数据数组
 */
function readJsonFile(filePath) {
  try {
    const content = fs.readFileSync(filePath, 'utf-8');
    const data = JSON.parse(content);
    
    if (!Array.isArray(data)) {
      throw new Error('JSON 文件内容不是数组格式');
    }
    
    return data;
  } catch (error) {
    console.error('读取 JSON 文件失败:', error);
    throw error;
  }
}

/**
 * 检查云数据库数据
 * @returns {Object} 检查结果
 */
async function checkData() {
  // 初始化云开发环境
  const { db } = initCloud();

  try {
    // 查询数据总量
    const countResult = await db.collection('daily_characters').count();
    
    console.log(`云数据库中共有 ${countResult.total} 条数据`);
    
    return {
      success: true,
      count: countResult.total,
      message: `云数据库中共有 ${countResult.total} 条数据`
    };
  } catch (error) {
    console.error('检查数据失败:', error);
    return {
      success: false,
      message: `检查数据失败: ${error.message}`,
      error: error.message
    };
  }
}

/**
 * 初始化每日一言数据库集合
 * @returns {Object} 初始化结果
 */
async function initDailyQuoteDatabase() {
  // 初始化云开发环境
  const { db } = initCloud();

  try {
    console.log('开始初始化每日一言数据库...');
    
    // 1. 检查并创建 daily_quotes 集合
    console.log('检查 daily_quotes 集合...');
    try {
      await db.collection('daily_quotes').get();
      console.log('✓ daily_quotes 集合已存在');
    } catch (error) {
      console.log('创建 daily_quotes 集合...');
      // 尝试获取集合，若不存在会自动创建
      await db.collection('daily_quotes').get();
      console.log('✓ daily_quotes 集合创建成功');
    }
    
    // 2. 检查并创建 daily_quotes_config 集合
    console.log('检查 daily_quotes_config 集合...');
    try {
      await db.collection('daily_quotes_config').get();
      console.log('✓ daily_quotes_config 集合已存在');
    } catch (error) {
      console.log('创建 daily_quotes_config 集合...');
      // 尝试获取集合，若不存在会自动创建
      await db.collection('daily_quotes_config').get();
      console.log('✓ daily_quotes_config 集合创建成功');
    }
    
    // 3. 初始化配置数据
    console.log('初始化配置数据...');
    const configResult = await db.collection('daily_quotes_config').get();
    if (configResult.data.length === 0) {
      // 插入默认配置
      await db.collection('daily_quotes_config').add({
        data: {
          lastModified: new Date(),
          version: '1.0.0',
          totalCount: 0,
          sources: ['菜根谭', '围炉夜话', '小窗幽记', '幽梦影', '了凡四训', '增广贤文', '道德经'],
          createdAt: new Date(),
          updatedAt: new Date()
        }
      });
      console.log('✓ 配置数据初始化成功');
    } else {
      console.log('✓ 配置数据已存在，跳过初始化');
    }
    
    console.log('每日一言数据库初始化完成');
    
    return {
      success: true,
      message: '每日一言数据库初始化成功',
      collections: ['daily_quotes', 'daily_quotes_config']
    };
  } catch (error) {
    console.error('初始化每日一言数据库失败:', error);
    return {
      success: false,
      message: `初始化失败: ${error.message}`,
      error: error.message
    };
  }
}

/**
 * 迁移每日一言数据
 * @returns {Object} 迁移结果
 */
async function migrateDailyQuoteData() {
  // 初始化云开发环境
  const { db } = initCloud();

  try {
    console.log('开始迁移每日一言数据...');
    
    // 1. 读取菜根谭数据
    console.log('读取菜根谭数据...');
    const dataPath = path.join(__dirname, '../../subgames/daily-quote/data.js');
    
    if (!fs.existsSync(dataPath)) {
      console.error('❌ 未找到 data.js 文件');
      return {
        success: false,
        message: '未找到 data.js 文件',
        error: 'File not found'
      };
    }
    
    // 读取并解析数据
    const dataContent = fs.readFileSync(dataPath, 'utf8');
    
    // 提取 quotes 数据
    const quotesMatch = dataContent.match(/module\.exports = \{[\s\S]*?"quotes": \[(.*?)\][\s\S]*?\};\s*$/);
    if (!quotesMatch) {
      console.error('❌ 无法解析 data.js 文件中的 quotes 数据');
      return {
        success: false,
        message: '无法解析 data.js 文件中的 quotes 数据',
        error: 'Data parse failed'
      };
    }
    
    let quotesJson = '[' + quotesMatch[1] + ']';
    // 修复可能的语法问题
    quotesJson = quotesJson.replace(/,\s*\]/g, ']');
    
    let quotes;
    try {
      quotes = JSON.parse(quotesJson);
    } catch (parseError) {
      console.error('❌ 解析 quotes 数据失败:', parseError);
      // 尝试使用 eval 解析
      try {
        // 构造一个安全的 eval 环境
        const module = { exports: {} };
        eval(dataContent);
        quotes = module.exports.quotes;
      } catch (evalError) {
        console.error('❌ eval 解析也失败:', evalError);
        return {
          success: false,
          message: '解析数据失败',
          error: 'Parse failed'
        };
      }
    }
    
    console.log(`✓ 成功读取 ${quotes.length} 条菜根谭数据`);
    
    // 2. 准备迁移数据
    console.log('准备迁移数据...');
    const migrateData = quotes.map(quote => ({
      id: quote.id,
      quote: quote.quote,
      source: quote.source || '',
      volumeNumber: quote.volumeNumber || '',
      category: quote.category || '',
      theme: quote.theme || '',
      fullText: quote.fullText || '',
      origin: '菜根谭', // 新增字段，标识格言来源
      createdAt: new Date(),
      updatedAt: new Date()
    }));
    
    console.log('✓ 数据准备完成');
    
    // 3. 批量导入数据
    console.log('批量导入数据...');
    
    // 分批导入，每批最多100条
    const batchSize = 100;
    let totalImported = 0;
    let totalFailed = 0;
    const errors = [];
    
    for (let i = 0; i < migrateData.length; i += batchSize) {
      const batch = migrateData.slice(i, i + batchSize);
      console.log(`导入批次 ${Math.floor(i / batchSize) + 1}, 条数: ${batch.length}`);
      
      for (const item of batch) {
        try {
          // 检查是否已存在
          const existing = await db.collection('daily_quotes').where({ id: item.id }).get();
          if (existing.data.length === 0) {
            await db.collection('daily_quotes').add({ data: item });
            totalImported++;
          } else {
            console.log(`跳过已存在的数据: ${item.id}`);
          }
        } catch (error) {
          console.error(`导入第 ${item.id} 条数据失败:`, error);
          totalFailed++;
          errors.push({ id: item.id, error: error.message });
        }
      }
      
      // 每批处理后暂停一下
      if (i + batchSize < migrateData.length) {
        await new Promise(resolve => setTimeout(resolve, 1000));
      }
    }
    
    console.log(`✓ 数据迁移完成，成功导入 ${totalImported} 条数据，失败 ${totalFailed} 条`);
    
    // 4. 更新配置信息
    console.log('更新配置信息...');
    try {
      await db.collection('daily_quotes_config').update({
        data: {
          lastModified: new Date(),
          totalCount: totalImported,
          updatedAt: new Date()
        }
      });
      console.log('✓ 配置信息更新成功');
    } catch (error) {
      console.error('更新配置信息失败:', error);
    }
    
    return {
      success: totalFailed === 0,
      message: `数据迁移完成，成功导入 ${totalImported} 条数据，失败 ${totalFailed} 条`,
      imported: totalImported,
      failed: totalFailed,
      total: migrateData.length,
      errors
    };
  } catch (error) {
    console.error('迁移每日一言数据失败:', error);
    return {
      success: false,
      message: `迁移失败: ${error.message}`,
      error: error.message
    };
  }
}

/**
 * 检查每日一言数据库状态
 * @returns {Object} 检查结果
 */
async function checkDailyQuoteData() {
  // 初始化云开发环境
  const { db } = initCloud();

  try {
    console.log('检查每日一言数据库状态...');
    
    // 检查配置集合
    const configResult = await db.collection('daily_quotes_config').get();
    const configCount = configResult.data.length;
    
    // 检查数据集合
    const countResult = await db.collection('daily_quotes').count();
    const dataCount = countResult.total;
    
    console.log(`配置数据: ${configCount} 条`);
    console.log(`菜根谭数据: ${dataCount} 条`);
    
    return {
      success: true,
      message: '每日一言数据库检查完成',
      configCount,
      dataCount,
      status: {
        config: configCount > 0 ? 'initialized' : 'not_initialized',
        data: dataCount > 0 ? 'migrated' : 'not_migrated'
      }
    };
  } catch (error) {
    console.error('检查每日一言数据库失败:', error);
    return {
      success: false,
      message: `检查失败: ${error.message}`,
      error: error.message
    };
  }
}

/**
 * 主函数
 * @param {Object} event - 事件参数
 * @param {Object} context - 上下文
 * @returns {Promise<Object>} 处理结果
 */
exports.main = async function(event, context) {
  try {
    // 根据 action 参数执行不同操作
    if (event.action === 'check') {
      // 检查数据
      const result = await checkData();
      return result;
    } else if (event.action === 'initDailyQuote') {
      // 初始化每日一言数据库
      const result = await initDailyQuoteDatabase();
      return result;
    } else if (event.action === 'migrateDailyQuote') {
      // 迁移每日一言数据
      const result = await migrateDailyQuoteData();
      return result;
    } else if (event.action === 'checkDailyQuote') {
      // 检查每日一言数据库状态
      const result = await checkDailyQuoteData();
      return result;
    } else if (event.action === 'fullDailyQuoteSetup') {
      // 完整的每日一言设置（初始化 + 迁移）
      console.log('开始完整的每日一言设置...');
      
      // 1. 初始化数据库
      const initResult = await initDailyQuoteDatabase();
      if (!initResult.success) {
        return initResult;
      }
      
      // 2. 迁移数据
      const migrateResult = await migrateDailyQuoteData();
      
      return {
        success: migrateResult.success,
        message: `完整设置完成: ${migrateResult.message}`,
        initResult,
        migrateResult
      };
    } else {
      // 默认执行导入操作
      // 读取导出的数据文件
      const jsonFilePath = path.join(__dirname, 'export_data.json');
      const data = readJsonFile(jsonFilePath);

      console.log(`读取到 ${data.length} 条数据`);

      // 验证数据格式
      const validData = data.filter(item => {
        const requiredFields = ['id', 'char', 'correctPronunciation', 'wrongPronunciations', 
                               'relatedPhrases', 'explanation', 'errorReasonType', 'difficultyLevel'];
        
        return requiredFields.every(field => field in item);
      });

      if (validData.length < data.length) {
        console.warn(`过滤掉 ${data.length - validData.length} 条无效数据`);
      }

      // 导入数据
      const result = await importData(validData);

      return {
        success: result.success,
        data: result,
        message: result.message
      };
    }
  } catch (error) {
    console.error('处理过程中发生错误:', error);
    return {
      success: false,
      message: `操作失败: ${error.message}`,
      error: error.message
    };
  }
};

/**
 * 本地测试函数
 * 可以直接运行此文件进行测试
 */
async function testImport() {
  console.log('开始本地测试导入...');
  
  try {
    // 读取导出的数据文件
    const jsonFilePath = path.join(__dirname, 'export_data.json');
    const data = readJsonFile(jsonFilePath);

    console.log(`读取到 ${data.length} 条数据`);

    // 验证数据格式
    const validData = data.filter(item => {
      const requiredFields = ['id', 'char', 'correctPronunciation', 'wrongPronunciations', 
                             'relatedPhrases', 'explanation', 'errorReasonType', 'difficultyLevel'];
      
      return requiredFields.every(field => field in item);
    });

    if (validData.length < data.length) {
      console.warn(`过滤掉 ${data.length - validData.length} 条无效数据`);
    }

    console.log(`准备导入 ${validData.length} 条有效数据`);
    
    // 统计数据分布
    const difficultyStats = {};
    const errorReasonStats = {};
    
    validData.forEach(item => {
      // 统计难度等级
      const difficulty = item.difficultyLevel;
      difficultyStats[difficulty] = (difficultyStats[difficulty] || 0) + 1;
      
      // 统计错误原因类型
      const errorReason = item.errorReasonType;
      errorReasonStats[errorReason] = (errorReasonStats[errorReason] || 0) + 1;
    });
    
    console.log('\n数据分布统计:');
    console.log('难度等级分布:');
    Object.entries(difficultyStats).forEach(([level, count]) => {
      console.log(`  ${level}: ${count} 条`);
    });
    
    console.log('\n错误原因类型分布:');
    Object.entries(errorReasonStats).forEach(([type, count]) => {
      console.log(`  类型 ${type}: ${count} 条`);
    });
    
    console.log('\n测试完成，数据验证通过');
    
  } catch (error) {
    console.error('测试失败:', error);
  }
}

// 如果直接运行此文件，则执行测试
if (require.main === module) {
  // 仅运行测试函数，不加载云函数模块
  testImport();
}